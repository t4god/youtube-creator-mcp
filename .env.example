# Optional public-data API key. Prefer `youtube-mcp auth` for private analytics.
YOUTUBE_API_KEY=

# auto uses macOS Keychain on macOS and a private per-user file elsewhere.
# Set file explicitly for headless/container environments.
YOUTUBE_MCP_SECRET_STORE=auto

# Guardrails. Writes are off unless explicitly enabled.
YOUTUBE_MCP_ENABLE_WRITES=false
YOUTUBE_MCP_ENABLE_DESTRUCTIVE=false

# Comma-separated absolute roots permitted for upload/download media operations.
YOUTUBE_MCP_MEDIA_ROOTS=/absolute/path/to/media,/another/allowed/path

# Optional storage overrides. Defaults live under ~/Library/Application Support/youtube-mcp.
YOUTUBE_MCP_DATA_DIR=
YOUTUBE_MCP_CACHE_TTL_SECONDS=300
